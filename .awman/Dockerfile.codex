FROM awman-awman:latest

# Force root for installation: a base image may have switched to a non-root
# user, and apt/cp/install need write access to /usr/local, /etc, /root.
USER root

# Reset env vars so installer behavior does not depend on what the base set:
#   - HOME drives where installers and tools write user-scoped files.
#   - DEBIAN_FRONTEND avoids interactive apt prompts.
#   - PATH prepends the agent baseline to whatever the base image set,
#     so installer-resolved binaries cannot be shadowed by the base while
#     useful base PATH additions (e.g. /usr/local/cargo/bin from
#     Dockerfile.dev) stay visible inside the agent container.
ENV HOME=/root \
    DEBIAN_FRONTEND=noninteractive \
    PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:$PATH
WORKDIR /root

# Strict shell for every RUN: -e fails fast, -o pipefail catches errors in
# `curl | bash` pipelines so a partial download cannot silently succeed.
SHELL ["/bin/bash", "-eo", "pipefail", "-c"]

# Override any inherited ENTRYPOINT/CMD so `docker run image <command> ...`
# behaves predictably regardless of how the base evolves.
ENTRYPOINT []
CMD ["/bin/bash"]

# ── Runtime prerequisites ─────────────────────────────────────────────────────
# Codex sandboxes command execution on Linux with bubblewrap and treats it as a
# hard prerequisite; without the `bwrap` binary on PATH, sandboxed exec fails.
# The base image does not ship it, so install it here (as root, before dropping
# to the runtime user) and prune apt lists to keep the layer small.
RUN apt-get update \
    && apt-get install -y --no-install-recommends bubblewrap \
    && rm -rf /var/lib/apt/lists/*

# ── Install agent package ─────────────────────────────────────────────────────
# Codex CLI is installed via OpenAI's official installer, which fetches the
# prebuilt package for the current architecture. Codex is a *package*, not a
# lone binary: bin/codex locates codex-package.json beside it and uses the
# bundled codex-resources/ (bwrap, voice) and codex-path/ (rg). Copying the
# bare binary out of the package breaks that lookup ("local Codex package is
# missing"), so the package stays intact and PATH gets symlinks into it.
#
# Where it goes: a fixed, root-owned /opt/codex — outside every $HOME. At
# runtime awman mounts the host's ~/.codex over /home/awman/.codex, which
# would hide (or, for a host-created `current` symlink, dangle) anything
# installed under the default $CODEX_HOME/packages. CODEX_HOME and
# CODEX_INSTALL_DIR are set for the installer only; the image's runtime
# CODEX_HOME stays the default ($HOME/.codex), where config and auth live.
# Root ownership also means a codex running as `awman` can never rewrite the
# installed package.
#
# The installer runs non-interactively (no "start Codex now?" prompt) with its
# bin dir already on PATH, so it leaves shell profiles alone. Saving the script
# first keeps `--retry` meaningful and the pipefail semantics simple.
#
# codex-code-mode-host (Code Mode's tool-execution helper) is only linked onto
# PATH by upstream on macOS; link it here too so Code Mode works on Linux.
RUN curl -fsSL --retry 5 --retry-delay 2 --retry-max-time 120 \
        https://chatgpt.com/codex/install.sh -o /tmp/codex-install.sh \
    && CODEX_HOME=/opt/codex \
       CODEX_INSTALL_DIR=/opt/codex/bin \
       CODEX_NON_INTERACTIVE=1 \
       PATH="/opt/codex/bin:$PATH" \
       sh /tmp/codex-install.sh \
    && rm -f /tmp/codex-install.sh \
    && codex_pkg=/opt/codex/packages/standalone/current \
    && test -f "$codex_pkg/codex-package.json" \
    && ln -sfn "$codex_pkg/bin/codex" /usr/local/bin/codex \
    && ln -sfn "$codex_pkg/bin/codex-code-mode-host" /usr/local/bin/codex-code-mode-host \
    && chmod -R a+rX /opt/codex

# ── awman user + workspace (idempotent against a base that already created it) ─
# Outer braces keep the && chain associated with the user-creation block,
# avoiding the `A || B && C && D` precedence trap that would otherwise skip
# `mkdir`/`chown` whenever the user already exists.
RUN { id -u awman >/dev/null 2>&1 \
       || useradd -m -s /bin/bash -d /home/awman awman 2>/dev/null \
       || useradd -s /bin/bash -d /home/awman awman ; } \
    && mkdir -p /workspace /home/awman \
    && chown -R awman:awman /workspace /home/awman

USER awman
ENV HOME=/home/awman \
    PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:$PATH
WORKDIR /workspace

# ── Smoke test: run as the runtime user so we verify the binary is on PATH and
# executable from the actual entrypoint context, not just for root. ───────────
# The resolved codex must still sit inside its package (bin/codex beside
# codex-package.json and the bundled rg), and `codex --version` proves the
# runtime user can execute it through the root-owned /opt/codex tree.
RUN test -x "$(command -v codex)" \
    && test -x "$(command -v bwrap)" \
    && test -x "$(command -v codex-code-mode-host)" \
    && codex_pkg="$(dirname "$(dirname "$(readlink -f "$(command -v codex)")")")" \
    && test -f "$codex_pkg/codex-package.json" \
    && test -x "$codex_pkg/codex-path/rg" \
    && codex --version
