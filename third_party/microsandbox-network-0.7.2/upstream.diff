+                    break;
+                }
+            }
+        });
+        let inbound = tokio::spawn(async move {
+            while let Some(bytes) = to_rx.recv().await {
+                if write.write_all(&bytes).await.is_err() {
+                    break;
+                }
+            }
+        });
+        tokio::time::timeout(Duration::from_secs(5), async {
