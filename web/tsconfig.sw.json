{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "webworker"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": [
    "src/sw/**/*.ts"
  ]
}
